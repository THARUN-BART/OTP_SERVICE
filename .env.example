# Server Port (Render automatically injects PORT)
APP_PORT=3000

# Brevo API Key (Starts with xkeysib-...)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Your verified email in Brevo (e.g. tharunp29112006@gmail.com)
BREVO_SENDER_EMAIL=tharunp29112006@gmail.com

# OTP Expiration in minutes (defaults to 5)
OTP_EXPIRY_MINUTES=5
